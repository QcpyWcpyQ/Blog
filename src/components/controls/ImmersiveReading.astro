---
import { Icon } from "astro-icon/components";
---

<button
  id="immersive-reading-btn"
  type="button"
  title="进入纯净阅读"
  aria-label="进入纯净阅读"
  aria-pressed="false"
  onclick="window.toggleImmersiveReading()"
  class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 hide"
>
  <Icon name="material-symbols:auto-stories" class="text-[1.25rem] reading-enter-icon" />
  <Icon name="material-symbols:logout" class="text-[1.25rem] reading-exit-icon" />
</button>

<script>
  import { initImmersiveReading } from "@/utils/immersive-reading-utils";

  initImmersiveReading();
</script>
