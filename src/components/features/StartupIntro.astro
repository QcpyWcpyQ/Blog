---
import { getImage } from "astro:assets";
import { profileConfig } from "@/config/profileConfig";
import { loadLocalImage } from "@/utils/schema-image";
import { url } from "@/utils/url-utils";

const introHold = 900;
const introExit = 300;

// Keep the opening portrait in sync with the sidebar profile configuration.
const avatar = profileConfig.avatar || "";
let avatarSrc = avatar;
if (avatar && !/^(?:https?:\/\/|\/|data:)/.test(avatar)) {
	const localAvatar = await loadLocalImage(avatar, "");
	avatarSrc = localAvatar
		? (await getImage({ src: localAvatar, width: 192, format: "webp", quality: 85 })).src
		: "";
} else if (avatar.startsWith("/")) {
	avatarSrc = url(avatar);
}
---

<div
	id="startup-intro"
	class="startup-intro"
	data-duration={introHold}
	data-exit-duration={introExit}
	style={`--intro-hold: ${introHold}ms; --intro-exit: ${introExit}ms`}
	role="dialog"
	aria-modal="true"
	aria-label={`正在进入 ${profileConfig.name} 的博客`}
	hidden
>
	<div class="intro-content">
		<div class="intro-avatar" aria-hidden="true">
			<div class="intro-avatar-glow"></div>
			<div class="intro-avatar-frame">
				{avatarSrc ? (
					<img src={avatarSrc} alt="" width="96" height="96" loading="eager" fetchpriority="high" decoding="async" />
				) : (
					<span>{profileConfig.name.slice(0, 1)}</span>
				)}
			</div>
		</div>
		<p class="intro-name">{profileConfig.name}</p>
		<p class="intro-status">霆霓快雨</p>
		<div class="intro-progress" aria-hidden="true">
			<div class="intro-progress-fill"></div>
		</div>
	</div>
	<button class="intro-skip" type="button">跳过开场</button>
</div>

<!-- Run while parsing the first body element, before the page can flash through.
     This lives outside Swup's containers and must not run again on a visit. -->
<script is:inline data-swup-ignore-script>
	(() => {
		const intro = document.getElementById("startup-intro");
		if (!intro || intro.dataset.initialized) return;
		intro.dataset.initialized = "true";
		const storageKey = "cpysama:startup-intro-seen:v1";
		let seen = false;
		try {
			seen = sessionStorage.getItem(storageKey) === "true";
		} catch {
			// The page must remain usable when browser storage is unavailable.
		}
		if (seen || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			intro.remove();
			return;
		}
		try {
			sessionStorage.setItem(storageKey, "true");
		} catch {}

		const skip = intro.querySelector(".intro-skip");
		const previousFocus = document.activeElement;
		const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const html = document.documentElement;
		const duration = Number(intro.dataset.duration);
		const exitDuration = Number(intro.dataset.exitDuration);
		let closing = false;
		let cleanedUp = false;
		let exitTimer;
		html.setAttribute("data-startup-intro", "running");
		intro.hidden = false;
		skip.focus({ preventScroll: true });

		function cleanup() {
			if (cleanedUp) return;
			cleanedUp = true;
			window.clearTimeout(startTimer);
			window.clearTimeout(exitTimer);
			window.clearTimeout(safetyTimer);
			html.removeAttribute("data-startup-intro");
			const restoreFocus = intro.contains(document.activeElement);
			intro.remove();
			if (restoreFocus && previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
			motion.removeEventListener("change", cleanup);
			document.removeEventListener("keydown", onKeyDown);
			window.removeEventListener("pagehide", cleanup);
			document.dispatchEvent(new Event("startup-intro:complete"));
		}
		function finish() {
			if (closing) return;
			closing = true;
			intro.dataset.state = "leaving";
			exitTimer = window.setTimeout(cleanup, exitDuration);
		}
		function onKeyDown(event) {
			if (event.key === "Escape") finish();
			// Keep keyboard focus out of the temporarily covered page.
			if (event.key === "Tab") {
				event.preventDefault();
				skip.focus();
			}
		}
		const startTimer = window.setTimeout(finish, duration);
		// Never leave a blocking opening screen behind if another script fails.
		const safetyTimer = window.setTimeout(cleanup, duration + exitDuration + 1000);
		skip.addEventListener("click", finish);
		motion.addEventListener("change", cleanup);
		document.addEventListener("keydown", onKeyDown);
		window.addEventListener("pagehide", cleanup);
	})();
</script>

<style>
	.startup-intro {
		position: fixed;
		inset: 0;
		z-index: 100000;
		display: grid;
		place-items: center;
		background: #050818;
		color: #f8fafc;
		isolation: isolate;
		touch-action: none;
		opacity: 1;
		transition: opacity var(--intro-exit) ease-in-out;
	}

	.startup-intro[hidden] {
		display: none;
	}

	:global(html[data-startup-intro]) {
		overflow: hidden;
	}

	.intro-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 2rem;
		animation: intro-enter 240ms ease-out both;
		transition: transform var(--intro-exit) ease-in-out, filter var(--intro-exit) ease-in-out;
	}

	.intro-avatar {
		position: relative;
		width: 96px;
		height: 96px;
		margin-bottom: 32px;
	}

	.intro-avatar-glow {
		position: absolute;
		inset: -6px;
		border-radius: 50%;
		background: conic-gradient(#a78bfa, #c4b5fd, #a78bfa, #a5d8ed, #a78bfa);
		filter: blur(4px);
		opacity: 0.65;
		animation: intro-orbit 4s linear infinite;
	}

	.intro-avatar-frame {
		position: relative;
		width: 100%;
		height: 100%;
		padding: 6px;
		border-radius: 50%;
		background: #0f172a;
		box-shadow: 0 12px 32px #0005;
	}

	.intro-avatar-frame img,
	.intro-avatar-frame span {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		object-position: center;
	}

	.intro-avatar-frame span {
		display: grid;
		place-items: center;
		font-size: 2rem;
	}

	.intro-name {
		margin: 0 0 8px;
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 24px;
		font-weight: 900;
		line-height: 1.4;
		letter-spacing: 0.2em;
		text-indent: 0.2em;
		text-transform: uppercase;
	}

	.intro-status {
		margin: 0 0 48px;
		color: #94a3b8;
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 10px;
		font-weight: 700;
		line-height: 1.5;
		letter-spacing: 0.5em;
		text-indent: 0.5em;
		white-space: nowrap;
	}

	.intro-progress {
		width: 160px;
		height: 1.5px;
		background: #1e293b;
	}

	.intro-progress-fill {
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, #a78bfa, #c4b5fd, #a5d8ed);
		box-shadow: 0 0 12px #818cf8aa;
		transform-origin: left;
		animation: intro-progress calc(var(--intro-hold) + var(--intro-exit)) linear both;
	}

	.startup-intro[data-state="leaving"] {
		opacity: 0;
		pointer-events: none;
	}

	.startup-intro[data-state="leaving"] .intro-content {
		transform: scale(1.03);
		filter: blur(5px);
	}

	.intro-skip {
		position: absolute;
		right: max(1.5rem, env(safe-area-inset-right));
		bottom: max(1.5rem, env(safe-area-inset-bottom));
		min-height: 44px;
		padding: 0.65rem 1rem;
		border: 1px solid #c4b5fd66;
		border-radius: 999px;
		background: #141e39;
		color: #e9e4ff;
		cursor: pointer;
	}
	.intro-skip:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 4px; }

	@keyframes intro-enter {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes intro-orbit {
		to { transform: rotate(360deg); }
	}

	@keyframes intro-progress {
		from { transform: scaleX(0); }
		to { transform: scaleX(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		.startup-intro {
			display: none;
		}
	}
</style>
