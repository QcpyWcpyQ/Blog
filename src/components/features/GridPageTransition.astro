---
import { url } from "@/utils/url-utils";
---

<div id="grid-page-transition" data-phase="idle" aria-hidden="true" inert>
	<div class="page-transition-grid">
		{Array.from({ length: 9 }, (_, index) => (
			<div class="page-transition-tile" data-tile={index}>
				{index === 4 && (
					<div class="page-transition-emblem">
						<img data-transition-emblem src={url("/favicon/keqing-emblem.png")} width="512" height="512" alt="" />
					</div>
				)}
			</div>
		))}
	</div>
</div>

<style>
	#grid-page-transition {
		--grid-surface: #141e39;
		--grid-line: #a7a9d51c;
		position: fixed;
		inset: 0;
		z-index: 99990;
		visibility: hidden;
		pointer-events: none;
		contain: layout paint;
	}

	#grid-page-transition[data-phase="covering"],
	#grid-page-transition[data-phase="covered"],
	#grid-page-transition[data-phase="revealing"] {
		visibility: visible;
		pointer-events: auto;
	}

	.page-transition-grid {
		display: grid;
		grid-template: repeat(3, 1fr) / repeat(3, 1fr);
		width: 100%;
		height: 100%;
	}

	.page-transition-tile {
		display: grid;
		place-items: center;
		min-width: 0;
		min-height: 0;
		margin: -0.5px;
		background: var(--grid-surface);
		box-shadow: inset 0 0 0 1px var(--grid-line);
		transform: scale(0);
		transform-origin: center;
	}

	.page-transition-tile:nth-child(even) { background: #17223e; }
	.page-transition-tile:nth-child(5) { background: #1d2846; }

	.page-transition-emblem {
		width: clamp(64px, 12vmin, 136px);
		max-width: 72%;
		aspect-ratio: 1;
	}

	.page-transition-emblem img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		filter: drop-shadow(0 0 14px #aaa2e529);
	}


	:global(html[data-grid-transition]) .transition-main,
	:global(html[data-grid-transition]) .transition-leaving,
	:global(html[data-grid-transition]) .content-panel,
	:global(html[data-grid-transition]) .onload-animation {
		transition: none !important;
		animation: none !important;
		transform: none !important;
		opacity: 1 !important;
	}

	:global(html[data-grid-transition]) #progress-bar { opacity: 0 !important; }

	@media (prefers-reduced-motion: reduce) {
		#grid-page-transition { display: none; }
	}
</style>
