---
import { backgroundWallpaper } from "@/config";
import { isHomePage } from "@/utils/layout-utils";
import { isArticleDetailPage, url } from "@/utils/url-utils";

interface Props {
	position?: string;
}

const { position = "center" } = Astro.props;
const settings = backgroundWallpaper.common?.homeWaterRipple;
const active = isHomePage(Astro.url.pathname) ||
	(settings?.showOnPostPage && isArticleDetailPage(Astro.url.pathname));
---

{settings?.enable && (
	<home-water-ripple
		data-image={url(settings.image)}
		data-normal-map={url(settings.normalMap)}
		data-settings={JSON.stringify(settings)}
		data-posts={settings.showOnPostPage ? "" : undefined}
		style={`--ripple-position: ${position}`}
		aria-hidden="true"
	>
		{active && <img src={url(settings.image)} alt="" width="3440" height="1440" fetchpriority="high" decoding="async" />}
		<canvas></canvas>
	</home-water-ripple>
)}

<script>
	import { initHomeWaterRipple } from "@/utils/home-water-ripple";

	if (!customElements.get("home-water-ripple")) {
		customElements.define("home-water-ripple", class extends HTMLElement {
			private cleanup?: () => void;

			connectedCallback() {
				this.cleanup ??= initHomeWaterRipple(this);
			}

			disconnectedCallback() {
				this.cleanup?.();
				this.cleanup = undefined;
			}
		});
	}
</script>

<style>
	home-water-ripple {
		position: absolute;
		inset: 0;
		z-index: 6;
		pointer-events: none;
	}

	home-water-ripple :global(img),
	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--ripple-position);
	}

	canvas {
		opacity: 0;
	}

	home-water-ripple[data-animated] canvas {
		opacity: 1;
	}

	/* 同时模糊 WebGL 动画与静态回退图，沿用主题的滚动模糊进度。 */
	:global(html[data-wallpaper-mode="fullscreen"]) home-water-ripple {
		filter: blur(var(--fullscreen-blur, var(--overlay-blur, 0px)));
		transform: scale(1.05);
	}

	:global(html[data-wallpaper-mode="fullscreen"] body.is-home) home-water-ripple {
		filter: blur(var(--fullscreen-blur, 0px));
	}

	/* 图片已随父层统一模糊，覆盖主题仅针对 img 的规则以免叠加。 */
	:global(html[data-wallpaper-mode="fullscreen"] body #wallpaper-wrapper) home-water-ripple :global(img) {
		filter: none !important;
		transform: none !important;
	}

	:global(body:not(.is-home):not(.is-post)) home-water-ripple,
	:global(body.is-post) home-water-ripple:not([data-posts]),
	:global([data-bg-video-playing]) home-water-ripple {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		canvas {
			display: none;
		}
	}

	@media (max-width: 1023px) {
		home-water-ripple :global(img) {
			object-position: center;
		}
	}
</style>
